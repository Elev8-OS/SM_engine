# Required: callers send this in the x-api-key header
API_KEY=change-me

# Optional: only these hosts may be used for photo URLs (comma separated). Empty = any https host.
ALLOWED_PHOTO_HOSTS=

# Optional: renders run one at a time by default
MAX_CONCURRENT=1

# Optional S3-compatible storage (Railway bucket). Without it, files are returned directly.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
